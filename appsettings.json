{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=INVOICES;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ApiInvoices",
    "Audience": "ApiInvoicesClient",
    "Key": "change-this-development-key-to-a-long-secure-production-secret",
    "AccessTokenMinutes": 30
  },
  "RefreshToken": {
    "CookieName": "refreshToken",
    "Days": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "https://localhost:3000",
      "https://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
